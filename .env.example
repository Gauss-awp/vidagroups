# =====================================================================
# Copiá este archivo como .env y completá con los datos de tus proyectos
# (Supabase → Project Settings → API Keys de cada proyecto).
#
# Para cambiar de ambiente, cambiá SOLO esta línea y reiniciá:
#   npx expo start -c
#   pruebas    → proyecto de pruebas: datos inventados y modo dev
#   produccion → proyecto que usa la iglesia
# =====================================================================
EXPO_PUBLIC_AMBIENTE=pruebas

# Proyecto de PRUEBAS
EXPO_PUBLIC_SUPABASE_URL_PRUEBAS=https://PROYECTO-PRUEBAS.supabase.co
EXPO_PUBLIC_SUPABASE_KEY_PRUEBAS=sb_publishable_...

# Proyecto de PRODUCCIÓN
EXPO_PUBLIC_SUPABASE_URL_PRODUCCION=https://PROYECTO-PRODUCCION.supabase.co
EXPO_PUBLIC_SUPABASE_KEY_PRODUCCION=sb_publishable_...
